  "description": "Sistema Contable para emprendimientos",
  "main": "app.js",
  "scripts": {
    "start": "node server.js",
    "app:sync": "npm run web:sync && npx cap sync",
    "web:sync": "cp index.html app.js styles.css manifest.webmanifest icon.svg api-config.js service-worker.js \"Logo Ashford.png\" www/",
